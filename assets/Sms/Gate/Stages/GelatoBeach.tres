[resource]
resource_name = "GELATO BEACH: the disc's select data (pass 135) -- the banner, the gradient and the 8 episode names from scenarioname.bmg. No level yet: Scene is empty, so an M gate with this Stage shows the select and the pick brings Mario back out of the gate; set Scene to the level when it exists and give each episode the ShineId of its shine. AllEpisodesOpen is ON (a deviation: with no shines to clear the game would open EPISODE 1 only) -- turn it off once the level has shines."
script = ExtResource("1_stage")
Scene = ""
StageName = "GELATO BEACH"
Banner = ExtResource("3_banner")
Episodes = [SubResource("Resource_ep1"), SubResource("Resource_ep2"), SubResource("Resource_ep3"), SubResource("Resource_ep4"), SubResource("Resource_ep5"), SubResource("Resource_ep6"), SubResource("Resource_ep7"), SubResource("Resource_ep8")]
GradientTopLeft = Color(1, 0, 0, 1)
GradientBottomRight = Color(1, 1, 0, 1)
GradientCycle = Vector3i(2, 0, 4)
AllEpisodesOpen = true
