[resource]
resource_name = "CORONA MOUNTAIN: the disc's select data (pass 135) -- the banner, the gradient and the 1 episode name from scenarioname.bmg. No level yet: Scene is empty, so an M gate with this Stage shows the select and the pick brings Mario back out of the gate; set Scene to the level when it exists and give each episode the ShineId of its shine. AllEpisodesOpen is ON (a deviation: with no shines to clear the game would open EPISODE 1 only) -- turn it off once the level has shines. DEVIATION: the game never shows the select for Corona (one scenario, no banner pane, TSelectMenu skips it); here one episode named with the game's unknown-name text so a Corona gate behaves like the others. Rename it or point the gate's Stage straight at the level."
script = ExtResource("1_stage")
Scene = ""
StageName = "CORONA MOUNTAIN"
Banner = ExtResource("3_banner")
Episodes = [SubResource("Resource_ep1")]
GradientTopLeft = Color(0, 0, 1, 1)
GradientBottomRight = Color(1, 0, 1, 1)
GradientCycle = Vector3i(0, 4, 2)
AllEpisodesOpen = true
