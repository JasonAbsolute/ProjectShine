[node name="KingBooRematch" type="Node3D" groups=["sms_rematch_boss"]]
script = ExtResource("1_script")
metadata/_sms_note = "Pass 157: KING BOO for the REMATCH (KINGBOO_REMATCH_gdoc.txt) -- the arena's own actor, apart from the casino's BossTelesa. This pass is his entrance only: hidden until the intro calls Spawn(), then the appear clip, the laugh clip with the long laugh, and the wait loop -- hovering (HoverBob), turning to face Mario (FaceMario), the soft glow and the twinkle at his body (Glow, Twinkle), the blink loop, the ghost's screen mix (GhostOpacity). The attacks, the teleports, the three faces and the hurt flip are later passes. RematchArena.tscn carries one as KingBoo; the intro there places him BooHeight over the floor at the BooSpawn marker."

