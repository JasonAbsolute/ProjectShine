[sub_resource type="Shader" id="Shader_81tff"]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_alpha_prepass, cull_disabled;

uniform sampler2D albedo_tex : source_color;
uniform float alpha_cutoff : hint_range(0.0, 1.0) = 0.08;
uniform vec2 scroll_speed = vec2(0.0, 0.0);

void fragment() {
    vec2 scrolled_uv = UV + scroll_speed * TIME;
    vec4 tex = texture(albedo_tex, scrolled_uv);

    // brightness of the pixel (black will be near 0)
    float brightness = max(tex.r, max(tex.g, tex.b));

    ALBEDO = tex.rgb;
    ALPHA = brightness;

    // hard cutout option (prevents soft ghosting on near-black)
    if (brightness < alpha_cutoff) {
        discard;
    }
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_tgllp"]
render_priority = 0
shader = SubResource("Shader_81tff")

